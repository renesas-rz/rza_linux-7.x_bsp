diff --git a/Makefile b/Makefile
index 51014fe4..1b6240dd 100644
--- a/Makefile
+++ b/Makefile
@@ -1086,9 +1086,11 @@ c_flags := $(KBUILD_CFLAGS) $(cpp_flags)
 # U-Boot objects....order is important (i.e. start must be first)
 
