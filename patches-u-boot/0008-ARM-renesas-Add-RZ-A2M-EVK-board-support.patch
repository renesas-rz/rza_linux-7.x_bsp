diff --git a/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi b/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
new file mode 100644
index 00000000..1fbadac8
--- /dev/null
+++ b/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Device Tree Source extras for U-Boot for the RZ/A2M EVK board
+ * Console on SCIF4 (CN5 USB serial)
+ */
+
+/ {
+	aliases {
+		serial0 = &scif4;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	soc {
+		bootph-all;
+	};
+};
+
+&ostm0 {
+	bootph-all;
+};
+
+&pinctrl {
+	bootph-all;
+
+	scif4_pins: serial4 {
+		pinmux = <RZA2_PINMUX(PORT9, 0, 4)>,	/* TxD4 */
+			 <RZA2_PINMUX(PORT9, 1, 4)>;	/* RxD4 */
+		bootph-all;
+	};
+};
+
+&scif4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&scif4_pins>;
+	status = "okay";
+	bootph-all;
+	clock = <66666666>;	/* ToDo: Replace by DM clock driver */
+};
