 board/renesas/rza2mevb/rza2mevb.c         | 34 +++++++++++++++++++
 configs/rza2mevb_defconfig                | 15 +++++++++
 include/configs/rza2mevb.h                | 26 ++++++++++++++
 11 files changed, 150 insertions(+), 5 deletions(-)
 create mode 100644 arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
 create mode 100644 board/renesas/rza2mevb/Kconfig
