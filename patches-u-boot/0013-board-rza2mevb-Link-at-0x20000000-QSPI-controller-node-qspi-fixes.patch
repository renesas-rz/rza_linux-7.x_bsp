From a8ae0e9fa7bf98c422c319348809ab3a86bd1228 Mon Sep 17 00:00:00 2001
From: Pabitra Adhikari <pabitraadhikari@gmail.com>
Date: Thu, 5 Nov 2026 11:07:12 -0800
Subject: [PATCH 13/13] board: rza2mevb: Link at 0x20000000, QSPI controller
 node, qspi fixes

- Link U-Boot at 0x20000000 and drop POSITION_INDEPENDENT: the boot ROM
  runs U-Boot in place from read-only QSPI flash, so self-relocation
  cannot patch the image and U-Boot hangs before the console
- Add the RZ/A2 RPC SPI controller and flash nodes (not in the upstream
  r7s9210 DTS) so the SPI flash, the environment and qspi work
- Drop stray console input in board_late_init so autoboot is not aborted
- qspi: send flash commands with spi_mem_exec_op() (the RPC SPI driver
  has no raw transfer support); clear PHYCNT.CKSEL before setting the
  DDR timing index; print unknown read commands

Signed-off-by: Pabitra Adhikari <pabitraadhikari@gmail.com>
---
 arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi | 27 +++++++++++
 board/renesas/rza2mevb/rza2mevb.c         |  9 ++++
 cmd/rza2_qspi.c                           | 48 +++++++++++++------
 configs/rza2mevb_defconfig                |  5 +-
 fix_qspi_spimem.py                        | 56 +++++++++++++++++++++++
 5 files changed, 130 insertions(+), 15 deletions(-)
 create mode 100755 fix_qspi_spimem.py

diff --git a/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi b/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
index 1fbadac8..cb7edbe3 100644
--- a/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
+++ b/arch/arm/dts/r7s9210-rza2mevb-u-boot.dtsi
@@ -39,3 +39,30 @@
 	bootph-all;
 	clock = <66666666>;	/* ToDo: Replace by DM clock driver */
 };
+
+/ {
+	aliases {
+		spi0 = &rpc;
+	};
+
+	rpc: spi@1f800000 {
+		compatible = "renesas,r7s9210-rpc-if";
+		reg = <0x1f800000 0x100>, <0x20000000 0x04000000>;
+		bank-width = <2>;
+		status = "okay";
+		spi-max-frequency = <50000000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		flash0: spi-flash@0 {
+			#address-cells = <1>;
+			#size-cells = <1>;
+			compatible = "jedec,spi-nor";
+			spi-max-frequency = <50000000>;
+			spi-tx-bus-width = <1>;
+			spi-rx-bus-width = <1>;
+			reg = <0>;
+			status = "okay";
+		};
+	};
+};
diff --git a/board/renesas/rza2mevb/rza2mevb.c b/board/renesas/rza2mevb/rza2mevb.c
index ac8ed99e..5c0779e0 100644
--- a/board/renesas/rza2mevb/rza2mevb.c
+++ b/board/renesas/rza2mevb/rza2mevb.c
@@ -7,6 +7,7 @@
  */
 
 #include <init.h>
+#include <stdio.h>
 #include <asm/global_data.h>
 #include <asm/io.h>
 #include <linux/bitops.h>
@@ -96,6 +97,14 @@ int board_init(void)
 	return 0;
 }
 
+/* Drop stray console input (the SCIF start-up sends one character in loopback) before autoboot */
+int board_late_init(void)
+{
+	while (tstc())
+		getchar();
+	return 0;
+}
+
 /* U-Boot uses the RZ/A2M on-chip memory, 4 MiB at CFG_SYS_SDRAM_BASE */
 int dram_init(void)
 {
diff --git a/cmd/rza2_qspi.c b/cmd/rza2_qspi.c
